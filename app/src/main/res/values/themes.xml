<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.QRServ" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Matches BrandCanvasLight (ui/theme/Color.kt) so the cold-start window background
             (the closest thing this app has to a splash screen) doesn't flash a different
             color before Compose draws the real background. -->
        <item name="android:windowBackground">#FFEDE8F3</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>
